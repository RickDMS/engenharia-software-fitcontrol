<mxfile host="app.diagrams.net"><diagram name="Estrutura MVC" id="p1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="root" value="&lt;b&gt;FitControl – Sistema de Gestão para Academias&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#8b5cf6;fontSize=12;fontColor=#222222;fontSize=14;" vertex="1" parent="1"><mxGeometry x="520" y="20" width="320" height="60" as="geometry"/></mxCell><mxCell id="aluno" value="&lt;b&gt;Aluno&lt;/b&gt;&lt;br&gt;&lt;i&gt;Atributos&lt;/i&gt;&lt;br&gt;nome, cpf, dataNascimento, telefone, email, endereço, status&lt;br&gt;&lt;i&gt;Métodos&lt;/i&gt;&lt;br&gt;cadastrar(), consultar(), atualizar(), inativar()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#8b5cf6;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="20" y="150" width="240" height="165" as="geometry"/></mxCell><mxCell id="prof" value="&lt;b&gt;Professor&lt;/b&gt;&lt;br&gt;&lt;i&gt;Atributos&lt;/i&gt;&lt;br&gt;nome, cpf, cref, especialidade, telefone, email&lt;br&gt;&lt;i&gt;Métodos&lt;/i&gt;&lt;br&gt;cadastrar(), consultar()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#8b5cf6;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="290" y="150" width="240" height="165" as="geometry"/></mxCell><mxCell id="plano" value="&lt;b&gt;Plano&lt;/b&gt;&lt;br&gt;&lt;i&gt;Atributos&lt;/i&gt;&lt;br&gt;nome, valor, duração, benefícios, ativo&lt;br&gt;&lt;i&gt;Métodos&lt;/i&gt;&lt;br&gt;cadastrar(), atualizar(), consultar()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#8b5cf6;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="560" y="150" width="240" height="165" as="geometry"/></mxCell><mxCell id="matr" value="&lt;b&gt;Matrícula&lt;/b&gt;&lt;br&gt;&lt;i&gt;Atributos&lt;/i&gt;&lt;br&gt;aluno, plano, dataInício, dataFim, status&lt;br&gt;&lt;i&gt;Métodos&lt;/i&gt;&lt;br&gt;realizar(), gerarMensalidades(), encerrar()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#8b5cf6;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="830" y="150" width="240" height="165" as="geometry"/></mxCell><mxCell id="acesso" value="&lt;b&gt;Acesso (Catraca)&lt;/b&gt;&lt;br&gt;&lt;i&gt;Atributos&lt;/i&gt;&lt;br&gt;aluno, dataHora, resultado, motivoBloqueio&lt;br&gt;&lt;i&gt;Métodos&lt;/i&gt;&lt;br&gt;validarSituação(), liberar(), bloquear(), registrar()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#8b5cf6;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1100" y="150" width="240" height="165" as="geometry"/></mxCell><mxCell id="aval" value="&lt;b&gt;Avaliação Física&lt;/b&gt;&lt;br&gt;&lt;i&gt;Atributos&lt;/i&gt;&lt;br&gt;data, peso, altura, percentualGordura&lt;br&gt;&lt;i&gt;Métodos&lt;/i&gt;&lt;br&gt;registrar(), consultar(), compararEvolução()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#8b5cf6;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="20" y="380" width="240" height="165" as="geometry"/></mxCell><mxCell id="treino" value="&lt;b&gt;Treino (Ficha)&lt;/b&gt;&lt;br&gt;&lt;i&gt;Atributos&lt;/i&gt;&lt;br&gt;objetivo, dataCriação, últimaAtualização&lt;br&gt;&lt;i&gt;Métodos&lt;/i&gt;&lt;br&gt;criar(), atualizar(), consultar()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#8b5cf6;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="290" y="380" width="240" height="165" as="geometry"/></mxCell><mxCell id="pag" value="&lt;b&gt;Pagamento (Mensalidade)&lt;/b&gt;&lt;br&gt;&lt;i&gt;Atributos&lt;/i&gt;&lt;br&gt;valor, vencimento, dataPagamento, status&lt;br&gt;&lt;i&gt;Métodos&lt;/i&gt;&lt;br&gt;registrar(), identificarInadimplência(), consultarHistórico()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#8b5cf6;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="830" y="380" width="240" height="165" as="geometry"/></mxCell><mxCell id="exerc" value="&lt;b&gt;Exercício&lt;/b&gt;&lt;br&gt;&lt;i&gt;Atributos&lt;/i&gt;&lt;br&gt;nome, séries, repetições, observações&lt;br&gt;&lt;i&gt;Métodos&lt;/i&gt;&lt;br&gt;adicionar(), remover()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#8b5cf6;fontSize=12;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="290" y="610" width="240" height="165" as="geometry"/></mxCell><mxCell id="e_root_aluno" value="" style="curved=1;html=1;endArrow=none;strokeColor=#8b5cf6;" edge="1" parent="1" source="root" target="aluno"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_root_prof" value="" style="curved=1;html=1;endArrow=none;strokeColor=#8b5cf6;" edge="1" parent="1" source="root" target="prof"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_root_plano" value="" style="curved=1;html=1;endArrow=none;strokeColor=#8b5cf6;" edge="1" parent="1" source="root" target="plano"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_root_matr" value="" style="curved=1;html=1;endArrow=none;strokeColor=#8b5cf6;" edge="1" parent="1" source="root" target="matr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_root_acesso" value="" style="curved=1;html=1;endArrow=none;strokeColor=#8b5cf6;" edge="1" parent="1" source="root" target="acesso"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_a" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;strokeColor=#8b5cf6;" edge="1" parent="1" source="aluno" target="aval"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_p" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;strokeColor=#8b5cf6;" edge="1" parent="1" source="prof" target="treino"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_t" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;strokeColor=#8b5cf6;" edge="1" parent="1" source="treino" target="exerc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_m" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;strokeColor=#8b5cf6;" edge="1" parent="1" source="matr" target="pag"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="doc" value="&lt;b&gt;&lt;font style='font-size:15px'&gt;FITCONTROL — Regras de Derivação MVC&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color='#555555'&gt;Este documento apresenta as diretrizes de arquitetura para a implementação do FitControl com Java Spring Boot (back-end) e React (front-end), seguindo o padrão MVC em camadas. Define como as entidades do diagrama UML são organizadas nas camadas do projeto.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Models (Classes do UML)&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;• Aluno&lt;br&gt;&amp;nbsp;&amp;nbsp;• Professor&lt;br&gt;&amp;nbsp;&amp;nbsp;• Plano&lt;br&gt;&amp;nbsp;&amp;nbsp;• Matrícula&lt;br&gt;&amp;nbsp;&amp;nbsp;• Pagamento (Mensalidade)&lt;br&gt;&amp;nbsp;&amp;nbsp;• Treino&lt;br&gt;&amp;nbsp;&amp;nbsp;• Exercício&lt;br&gt;&amp;nbsp;&amp;nbsp;• Avaliação Física&lt;br&gt;&amp;nbsp;&amp;nbsp;• Acesso&lt;br&gt;&lt;br&gt;&lt;b&gt;Controllers&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;• AlunoController – cadastro, consulta, atualização e inativação de alunos&lt;br&gt;&amp;nbsp;&amp;nbsp;• ProfessorController – cadastro e consulta de professores&lt;br&gt;&amp;nbsp;&amp;nbsp;• PlanoController – administra planos (valor, duração, benefícios)&lt;br&gt;&amp;nbsp;&amp;nbsp;• MatriculaController – vincula aluno a plano e gera mensalidades&lt;br&gt;&amp;nbsp;&amp;nbsp;• PagamentoController – registra pagamentos, histórico e inadimplência&lt;br&gt;&amp;nbsp;&amp;nbsp;• TreinoController – cria, atualiza e consulta fichas e exercícios&lt;br&gt;&amp;nbsp;&amp;nbsp;• AvaliacaoFisicaController – registra e consulta avaliações&lt;br&gt;&amp;nbsp;&amp;nbsp;• AcessoController – valida situação e registra entrada na catraca&lt;br&gt;&amp;nbsp;&amp;nbsp;• RelatorioController – relatórios de alunos, financeiro e frequência&lt;br&gt;&amp;nbsp;&amp;nbsp;• AuthController – login e recuperação de senha&lt;br&gt;&lt;br&gt;&lt;b&gt;Views (React)&lt;/b&gt;&lt;br&gt;&lt;b&gt;Recepcionista cadastra e matricula:&lt;/b&gt; CadastrarAluno, ConsultarAluno, RealizarMatricula&lt;br&gt;&lt;b&gt;Recepcionista registra pagamentos:&lt;/b&gt; RegistrarPagamento, Inadimplentes&lt;br&gt;&lt;b&gt;Professor cria treinos:&lt;/b&gt; CriarFicha, AtualizarFicha&lt;br&gt;&lt;b&gt;Professor avalia alunos:&lt;/b&gt; RegistrarAvaliacao, HistoricoEvolucao&lt;br&gt;&lt;b&gt;Aluno consulta treino e avaliações:&lt;/b&gt; MeuTreino, MinhasAvaliacoes&lt;br&gt;&lt;b&gt;Aluno acompanha finanças e dados:&lt;/b&gt; MinhasMensalidades, MeusDados&lt;br&gt;&lt;b&gt;Gerente gerencia planos:&lt;/b&gt; GerenciarPlanos&lt;br&gt;&lt;b&gt;Gerente consulta relatórios:&lt;/b&gt; RelatorioAlunos, RelatorioFinanceiro, RelatorioFrequencia&lt;br&gt;&lt;b&gt;Catraca:&lt;/b&gt; integração via API (AcessoController), sem tela web&lt;br&gt;&lt;b&gt;Todos os perfis:&lt;/b&gt; Login, RecuperarSenha" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;fillColor=#ffffff;strokeColor=#dddddd;shadow=1;fontSize=11;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="20" y="840" width="640" height="760" as="geometry"/></mxCell><mxCell id="docicon" value="📄" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c4b5fd;fontSize=20;" vertex="1" parent="1"><mxGeometry x="0" y="810" width="44" height="44" as="geometry"/></mxCell><mxCell id="codelbl" value="&lt;b&gt;Code&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="700" y="810" width="100" height="24" as="geometry"/></mxCell><mxCell id="code" value="&lt;font face='Courier New' color='#ffffff'&gt;FITCONTROL&lt;br&gt;├──&amp;nbsp;backend&amp;nbsp;(Java&amp;nbsp;Spring&amp;nbsp;Boot)&lt;br&gt;│&amp;nbsp;&amp;nbsp;&amp;nbsp;├──&amp;nbsp;model&lt;br&gt;│&amp;nbsp;&amp;nbsp;&amp;nbsp;│&amp;nbsp;&amp;nbsp;&amp;nbsp;├──&amp;nbsp;Aluno.java&lt;br&gt;│&amp;nbsp;&amp;nbsp;&amp;nbsp;│&amp;nbsp;&amp;nbsp;&amp;nbsp;├──&amp;nbsp;Professor.java&lt;br&gt;│&amp;nbsp;&amp;nbsp;&amp;nbsp;│&amp;nbsp;&amp;nbsp;&amp;nbsp;├──&amp;nbsp;Plano.java&lt;br&gt;│&amp;nbsp;&amp;nbsp;&amp;nbsp;│&amp;nbsp;&amp;nbsp;&amp;nbsp;├──&amp;nbsp;Matricula.java&lt;br&gt;│&amp;nbsp;&amp;nbsp;&amp;nbsp;│&amp;nbsp;&amp;nbsp;&amp;nbsp;├──&amp;nbsp;Pagamento.java&lt;br&gt;│&amp;nbsp;&amp;nbsp;&amp;nbsp;│&amp;nbsp;&amp;nbsp;&amp;nbsp;├──&amp;nbsp;Treino.java&lt;br&gt;│&amp;nbsp;&amp;nbsp;&amp;nbsp;│&amp;nbsp;&amp;nbsp;&amp;nbsp;├──&amp;nbsp;Exercicio.java&lt;br&gt;│&amp;nbsp;&amp;nbsp;&amp;nbsp;│&amp;nbsp;&amp;nbsp;&amp;nbsp;├──&amp;nbsp;AvaliacaoFisica.java&lt;br&gt;│&amp;nbsp;&amp;nbsp;&amp;nbsp;│&amp;nbsp;&amp;nbsp;&amp;nbsp;└──&amp;nbsp;Acesso.java&lt;br&gt;│&amp;nbsp;&amp;nbsp;&amp;nbsp;├──&amp;nbsp;controller&lt;br&gt;│&amp;nbsp;&amp;nbsp;&amp;nbsp;│&amp;nbsp;&amp;nbsp;&amp;nbsp;├──&amp;nbsp;AlunoController.java&lt;br&gt;│&amp;nbsp;&amp;nbsp;&amp;nbsp;│&amp;nbsp;&amp;nbsp;&amp;nbsp;├──&amp;nbsp;ProfessorController.java&lt;br&gt;│&amp;nbsp;&amp;nbsp;&amp;nbsp;│&amp;nbsp;&amp;nbsp;&amp;nbsp;├──&amp;nbsp;PlanoController.java&lt;br&gt;│&amp;nbsp;&amp;nbsp;&amp;nbsp;│&amp;nbsp;&amp;nbsp;&amp;nbsp;├──&amp;nbsp;MatriculaController.java&lt;br&gt;│&amp;nbsp;&amp;nbsp;&amp;nbsp;│&amp;nbsp;&amp;nbsp;&amp;nbsp;├──&amp;nbsp;PagamentoController.java&lt;br&gt;│&amp;nbsp;&amp;nbsp;&amp;nbsp;│&amp;nbsp;&amp;nbsp;&amp;nbsp;├──&amp;nbsp;TreinoController.java&lt;br&gt;│&amp;nbsp;&amp;nbsp;&amp;nbsp;│&amp;nbsp;&amp;nbsp;&amp;nbsp;├──&amp;nbsp;AvaliacaoFisicaController.java&lt;br&gt;│&amp;nbsp;&amp;nbsp;&amp;nbsp;│&amp;nbsp;&amp;nbsp;&amp;nbsp;├──&amp;nbsp;AcessoController.java&lt;br&gt;│&amp;nbsp;&amp;nbsp;&amp;nbsp;│&amp;nbsp;&amp;nbsp;&amp;nbsp;├──&amp;nbsp;RelatorioController.java&lt;br&gt;│&amp;nbsp;&amp;nbsp;&amp;nbsp;│&amp;nbsp;&amp;nbsp;&amp;nbsp;└──&amp;nbsp;AuthController.java&lt;br&gt;│&amp;nbsp;&amp;nbsp;&amp;nbsp;├──&amp;nbsp;service&lt;br&gt;│&amp;nbsp;&amp;nbsp;&amp;nbsp;│&amp;nbsp;&amp;nbsp;&amp;nbsp;├──&amp;nbsp;AlunoService.java&lt;br&gt;│&amp;nbsp;&amp;nbsp;&amp;nbsp;│&amp;nbsp;&amp;nbsp;&amp;nbsp;├──&amp;nbsp;PagamentoService.java&lt;br&gt;│&amp;nbsp;&amp;nbsp;&amp;nbsp;│&amp;nbsp;&amp;nbsp;&amp;nbsp;├──&amp;nbsp;TreinoService.java&lt;br&gt;│&amp;nbsp;&amp;nbsp;&amp;nbsp;│&amp;nbsp;&amp;nbsp;&amp;nbsp;└──&amp;nbsp;...&amp;nbsp;(demais&amp;nbsp;seguem&amp;nbsp;o&amp;nbsp;mesmo&amp;nbsp;padrão)&lt;br&gt;│&amp;nbsp;&amp;nbsp;&amp;nbsp;└──&amp;nbsp;repository&lt;br&gt;│&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;├──&amp;nbsp;AlunoRepository.java&lt;br&gt;│&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;├──&amp;nbsp;PagamentoRepository.java&lt;br&gt;│&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;├──&amp;nbsp;TreinoRepository.java&lt;br&gt;│&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;└──&amp;nbsp;...&amp;nbsp;(demais&amp;nbsp;seguem&amp;nbsp;o&amp;nbsp;mesmo&amp;nbsp;padrão)&lt;br&gt;└──&amp;nbsp;frontend&amp;nbsp;(React)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;└──&amp;nbsp;views&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;├──&amp;nbsp;Aluno&amp;nbsp;(CadastrarAluno.jsx,&amp;nbsp;ConsultarAluno.jsx,&amp;nbsp;MeusDados.jsx)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;├──&amp;nbsp;Professor&amp;nbsp;(CadastrarProfessor.jsx,&amp;nbsp;ConsultarProfessor.jsx)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;├──&amp;nbsp;Plano&amp;nbsp;(GerenciarPlanos.jsx)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;├──&amp;nbsp;Matricula&amp;nbsp;(RealizarMatricula.jsx)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;├──&amp;nbsp;Pagamento&amp;nbsp;(RegistrarPagamento.jsx,&amp;nbsp;Inadimplentes.jsx,&amp;nbsp;MinhasMensalidades.jsx)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;├──&amp;nbsp;Treino&amp;nbsp;(CriarFicha.jsx,&amp;nbsp;AtualizarFicha.jsx,&amp;nbsp;MeuTreino.jsx)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;├──&amp;nbsp;AvaliacaoFisica&amp;nbsp;(RegistrarAvaliacao.jsx,&amp;nbsp;HistoricoEvolucao.jsx,&amp;nbsp;MinhasAvaliacoes.jsx)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;├──&amp;nbsp;Relatorio&amp;nbsp;(RelatorioAlunos.jsx,&amp;nbsp;RelatorioFinanceiro.jsx,&amp;nbsp;RelatorioFrequencia.jsx)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;└──&amp;nbsp;Auth&amp;nbsp;(Login.jsx,&amp;nbsp;RecuperarSenha.jsx)&lt;/font&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fillColor=#050536;strokeColor=none;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="840" width="720" height="760" as="geometry"/></mxCell><mxCell id="e_doc_code" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=none;strokeColor=#888888;" edge="1" parent="1" source="doc" target="code"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Fluxograma Matrícula e Acesso" id="p2"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1450" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id